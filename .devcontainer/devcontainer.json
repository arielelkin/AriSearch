{
  "name": "arisearch",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "init": true,
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  "containerEnv": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "openai.chatgpt",
        "anthropic.claude-code"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/arisearch/bin/python"
      }
    }
  },
  "postCreateCommand": ".devcontainer/setup-codespaces.sh && conda run --no-capture-output -n arisearch python .devcontainer/verify_tools.py",
  "portsAttributes": {
    "8000": {
      "label": "Python HTTP server",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  },
  "initializeCommand": "install -d -m 0700 \"${localEnv:HOME}/.vscode-server\" \"${localEnv:HOME}/.vscode-server/data/User/workspaceStorage\" \"${localEnv:HOME}/.vscode-server-workspaces/${localWorkspaceFolderBasename}\" \"${localEnv:HOME}/.agent-state/${localWorkspaceFolderBasename}/codex\" \"${localEnv:HOME}/.agent-state/${localWorkspaceFolderBasename}/claude\" && if [ ! -e \"${localEnv:HOME}/.agent-state/${localWorkspaceFolderBasename}/claude.json\" ]; then (umask 077; printf '%s\\n' '{}' > \"${localEnv:HOME}/.agent-state/${localWorkspaceFolderBasename}/claude.json\"); fi",
  "mounts": [
    "source=${localEnv:HOME}/.vscode-server,target=/home/vscode/.vscode-server,type=bind",
    "source=${localEnv:HOME}/.vscode-server-workspaces/${localWorkspaceFolderBasename},target=/home/vscode/.vscode-server/data/User/workspaceStorage,type=bind",
    "source=${localEnv:HOME}/.agent-state/${localWorkspaceFolderBasename}/codex,target=/home/vscode/.codex,type=bind",
    "source=${localEnv:HOME}/.agent-state/${localWorkspaceFolderBasename}/claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.agent-state/${localWorkspaceFolderBasename}/claude.json,target=/home/vscode/.claude.json,type=bind"
  ]
}
